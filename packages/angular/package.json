{
  "name": "@sparshlabs/angular",
  "version": "0.1.0",
  "description": "Angular binding for sparsh: [sparshGuard], [sparshGuardTarget], provideActivationGuard().",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "build": "ng-packagr -p ng-package.json -c tsconfig.lib.json",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@sparshlabs/core": "workspace:*",
    "@sparshlabs/dom": "workspace:*",
    "tslib": "^2.8.1"
  },
  "peerDependencies": {
    "@angular/common": ">=22.0.0",
    "@angular/core": ">=22.0.0"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.9.0",
    "@angular/build": "~22.2.0",
    "@angular/common": "~22.2.0",
    "@angular/compiler": "~22.2.0",
    "@angular/compiler-cli": "~22.2.0",
    "@angular/core": "~22.2.0",
    "@angular/platform-browser": "~22.2.0",
    "@angular/platform-browser-dynamic": "~22.2.0",
    "@angular/platform-server": "~22.2.0",
    "jsdom": "^25.0.1",
    "ng-packagr": "~22.2.0",
    "rxjs": "^7.8.1",
    "typescript": "~6.0.0",
    "vitest": "^4.1.0",
    "zone.js": "~0.16.0"
  },
  "publishConfig": {
    "access": "public",
    "directory": "dist"
  }
}
