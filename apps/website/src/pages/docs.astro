---
import Code from '../components/Code.astro'
import DocsShell from '../components/DocsShell.astro'
import { href } from '../lib/paths'

const reactProvider = `import { ActivationGuardProvider } from '@sparshlabs/react'

export function App() {
  return (
    <ActivationGuardProvider mode="enforce">
      <YourApp />
    </ActivationGuardProvider>
  )
}`

const vueProvider = `<script setup lang="ts">
import { ActivationGuardProvider } from '@sparshlabs/vue'
</script>

<template>
  <ActivationGuardProvider mode="enforce">
    <YourApp />
  </ActivationGuardProvider>
</template>`

const angularProvider = `import { Component } from '@angular/core'
import { ActivationGuardDirective } from '@sparshlabs/angular'

@Component({
  selector: 'app-root',
  imports: [ActivationGuardDirective],
  template: \`
    <main sparshGuard mode="enforce">
      <app-shell />
    </main>
  \`,
})
export class AppComponent {}`

const solidProvider = `import { ActivationGuardProvider } from '@sparshlabs/solidjs'

export function App() {
  return (
    <ActivationGuardProvider mode="enforce">
      <YourApp />
    </ActivationGuardProvider>
  )
}`

const svelteProvider = `<script lang="ts">
  import { ActivationGuardProvider } from '@sparshlabs/svelte'
  import YourApp from './YourApp.svelte'
</script>

<ActivationGuardProvider mode="enforce">
  <YourApp />
</ActivationGuardProvider>`

const observeDecisions = `import type { Decision } from '@sparshlabs/react'

function recordDecision(decision: Decision) {
  if (decision.enforced) {
    analytics.track('activation_blocked', {
      policy: decision.policy,
      kind: decision.event.kind,
    })
  }
}`

const installReact = 'npm install @sparshlabs/react'
const installVue = 'npm install @sparshlabs/vue'
const installAngular = 'npm install @sparshlabs/angular'
const installSolid = 'npm install @sparshlabs/solidjs'
const installSvelte = 'npm install @sparshlabs/svelte'
const installDom = 'npm install @sparshlabs/dom'
---

<DocsShell
  title="Getting started"
  description="Install the right binding, put the guard around the UI you want to protect, and understand what happens when a tap looks unsafe."
>
  <section class="docs-section" id="availability">
    <p class="section-kicker">BEFORE YOU START</p>
    <h2>Choose a binding</h2>
    <p>
      sparsh separates its interaction engine from its platform adapters and framework bindings. Use
      the binding that matches your app; the React, Vue, Angular, SolidJS, and Svelte bindings install
      the browser DOM adapter for you.
    </p>
    <p class="callout">A small naming note: <em>sparsh</em> means “touch” in Sanskrit.</p>
    <div class="table-wrap">
      <table class="docs-table">
        <thead><tr><th>Package</th><th>Use it when</th><th>Requirements</th></tr></thead>
        <tbody>
          <tr><td><code>@sparshlabs/react</code></td><td>Your UI is React.</td><td>React 18 or later</td></tr>
          <tr><td><code>@sparshlabs/vue</code></td><td>Your UI is Vue 3.</td><td>Vue 3.3 or later; Composition API</td></tr>
          <tr><td><code>@sparshlabs/angular</code></td><td>Your UI is Angular.</td><td>Angular 22 or later</td></tr>
          <tr><td><code>@sparshlabs/solidjs</code></td><td>Your UI is SolidJS.</td><td>Solid 1.8 or later</td></tr>
          <tr><td><code>@sparshlabs/svelte</code></td><td>Your UI is Svelte.</td><td>Svelte 5.29 or later</td></tr>
          <tr><td><code>@sparshlabs/dom</code></td><td>You use vanilla JavaScript or a different framework.</td><td>A browser DOM root</td></tr>
        </tbody>
      </table>
    </div>
    <p class="callout">
      Install the package that matches your app. The React, Vue, Angular, SolidJS, and Svelte bindings bring in
      <code>@sparshlabs/dom</code> automatically; install it directly only for vanilla JS or a
      custom host.
    </p>
    <Code code={installDom} lang="sh" theme="github-dark" />
    <p>See <a href={href('/docs/dom/')}>DOM / vanilla API</a> for the direct <code>createGuard</code> usage.</p>
  </section>

  <section class="docs-section" id="react-setup">
    <p class="section-kicker">01 · REACT</p>
    <h2>Wrap the part of the app you want to protect</h2>
    <p>
      Add one provider near the root of the interactive surface. It observes activations in that
      subtree, so most controls do not need a sparsh-specific prop or wrapper.
    </p>
    <Code code={installReact} lang="sh" theme="github-dark" />
    <Code code={reactProvider} lang="tsx" theme="github-dark" />
    <p>
      The provider is a client component and attaches its DOM listeners in an effect. In React
      Server Component apps, place it in a client boundary. See the <a href={href('/docs/react/')}>React
      API reference</a> for hooks, callbacks, and provider options.
    </p>
  </section>

  <section class="docs-section" id="vue-setup">
    <p class="section-kicker">02 · VUE</p>
    <h2>Use the provider as a layout boundary</h2>
    <p>
      The Vue provider makes its guard available to descendants through Vue’s provide/inject
      mechanism. It attaches after mount and removes its listeners when unmounted.
    </p>
    <Code code={installVue} lang="sh" theme="github-dark" />
    <Code code={vueProvider} lang="vue" theme="github-dark" />
    <p>See the <a href={href('/docs/vue/')}>Vue API reference</a> for Composition API patterns and props.</p>
  </section>

  <section class="docs-section" id="angular-setup">
    <p class="section-kicker">03 · ANGULAR</p>
    <h2>Put the directive on the element you want to protect</h2>
    <p>
      The <code>sparshGuard</code> directive guards the element it’s placed on and everything inside
      it, without adding a wrapper. It attaches after the first render, never runs during
      server-side rendering, and removes its listeners when the element is destroyed. To guard the
      whole document instead, add <code>provideActivationGuard()</code> to your application config.
    </p>
    <Code code={installAngular} lang="sh" theme="github-dark" />
    <Code code={angularProvider} lang="ts" theme="github-dark" />
    <p>See the <a href={href('/docs/angular/')}>Angular API reference</a> for the provider, the element-feedback directive, and inputs.</p>
  </section>

  <section class="docs-section" id="solidjs-setup">
    <p class="section-kicker">04 · SOLIDJS</p>
    <h2>Wrap the part of the app you want to protect</h2>
    <p>
      The SolidJS provider shares its guard with descendants through Solid context. It attaches in
      an effect after the first render, never runs during server-side rendering, and removes its
      listeners when it is disposed, so it works unchanged in SolidStart.
    </p>
    <Code code={installSolid} lang="sh" theme="github-dark" />
    <Code code={solidProvider} lang="tsx" theme="github-dark" />
    <p>See the <a href={href('/docs/solidjs/')}>SolidJS API reference</a> for the element-feedback hook and props.</p>
  </section>

  <section class="docs-section" id="svelte-setup">
    <p class="section-kicker">05 · SVELTE</p>
    <h2>Wrap the part of the app you want to protect</h2>
    <p>
      The Svelte provider shares its guard with descendants through Svelte context. It attaches in
      an effect after the first render, never runs during server-side rendering, and removes its
      listeners when it is destroyed, so it works unchanged in SvelteKit. It requires Svelte 5.
    </p>
    <Code code={installSvelte} lang="sh" theme="github-dark" />
    <Code code={svelteProvider} lang="svelte" theme="github-dark" />
    <p>See the <a href={href('/docs/svelte/')}>Svelte API reference</a> for the element-feedback hook and props.</p>
  </section>

  <section class="docs-section" id="first-feedback">
    <p class="section-kicker">06 · OBSERVE THE RESULT</p>
    <h2>Make a block understandable</h2>
    <p>
      Enforce mode is the default. A suspicious activation can be stopped, and <code>onDecision</code>
      tells you whether a decision was allowed or enforced. Render a status message or record the
      policy and input kind for diagnostics; avoid logging sensitive user content.
    </p>
    <Code code={observeDecisions} lang="tsx" theme="github-dark" />
    <p>
      Use report mode when tuning a policy: it still reports suspicious decisions, but lets the
      activation through. <code>decision.allowed</code> is the policy verdict;
      <code>decision.enforced</code> tells you whether sparsh actually blocked the interaction.
    </p>
  </section>

  <section class="docs-section" id="next-steps">
    <p class="section-kicker">NEXT STEPS</p>
    <h2>Understand the signals before tuning them</h2>
    <ul>
      <li><a href={href('/docs/concepts/')}>Core concepts</a> explains modes, policies, accessibility behavior, and known limits.</li>
      <li><a href={href('/docs/dom/')}>DOM / vanilla API</a> covers low-level integration and cleanup.</li>
      <li><a href={href('/playground/')}>The playground</a> lets you try the guard against moving interfaces.</li>
    </ul>
  </section>
</DocsShell>
