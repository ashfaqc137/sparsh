---
import '../styles.css'

interface Props {
  title: string
  description?: string
}

const {
  title,
  description = 'sparsh is a framework-agnostic UX-safety primitive that blocks accidental UI activation.',
} = Astro.props
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/" aria-label="sparsh home">
        <span class="brand-mark" aria-hidden="true">s</span>
        <span>sparsh</span>
      </a>
      <nav class="site-nav" aria-label="Main navigation">
        <a href="/" aria-current={Astro.url.pathname === '/' ? 'page' : undefined}>Why sparsh</a>
        <a href="/how-it-works/" aria-current={Astro.url.pathname.startsWith('/how-it-works') ? 'page' : undefined}>How it works</a>
        <a href="/demo/" aria-current={Astro.url.pathname.startsWith('/demo') ? 'page' : undefined}>Demo</a>
        <a href="/playground/" aria-current={Astro.url.pathname.startsWith('/playground') ? 'page' : undefined}>Playground</a>
        <a href="/docs/" aria-current={Astro.url.pathname.startsWith('/docs') ? 'page' : undefined}>Docs</a>
        <a href="https://github.com/ashfaqc137/sparsh" target="_blank" rel="noreferrer">GitHub</a>
      </nav>
    </header>
    <slot />
    <footer class="site-footer">
      <a href="/" class="footer-brand">sparsh <span>·</span> trustworthy touch</a>
      <span>Made for interfaces that move.</span>
      <a href="https://github.com/ashfaqc137/sparsh" target="_blank" rel="noreferrer">Source on GitHub</a>
    </footer>
  </body>
</html>
