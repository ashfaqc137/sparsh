---
import '../styles.css'

interface Props {
  title: string
  description?: string
}

const {
  title,
  description = 'sparsh is a framework-agnostic UX-safety primitive that blocks accidental UI activation.',
} = Astro.props
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body>
    <slot />
  </body>
</html>
